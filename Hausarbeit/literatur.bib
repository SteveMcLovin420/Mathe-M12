% QUELLEN: Neue Einträge erhalten einen eindeutigen Schlüssel, z. B. polya1945.
% Im Text: \citet{polya1945} -> Autor im Satz; \citep{polya1945} -> (Autor, Jahr).
% Mit Seite: \citep[S.~23]{polya1945}; Seiten in eurer Ausgabe nachprüfen.
% Nach Änderungen make ausführen; latexmk erledigt alle LaTeX/BibTeX-Läufe.
% Reale Beispielquellen: nur tatsächlich gelesene/verwendete Literatur übernehmen.

@book{polya1945,
  author    = {P{\'o}lya, George},
  title     = {How to Solve It: A New Aspect of Mathematical Method},
  year      = {1945},
  publisher = {Princeton University Press},
  address   = {Princeton}
}

@book{spivak2008,
  author    = {Spivak, Michael},
  title     = {Calculus},
  edition   = {4},
  year      = {2008},
  publisher = {Publish or Perish},
  address   = {Houston}
}

